# Optionnel : chemin absolu vers la base locale SQLite.
# DATABASE_PATH=C:\chemin\prive\prospection.db

# Activer uniquement après choix et accord sur le service, le traitement des données et son coût.
# API HTTPS de type Chat Completions / JSON (base terminant généralement par /v1).
AI_AUTHORIZED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=5
AI_MAX_OUTPUT_TOKENS=6000

# SMTP avec TLS, port 465 ou 587. Deux adresses e-mail simples, sans nom d'affichage.
EMAIL_AUTHORIZED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TEST_EMAIL_FROM=
TEST_EMAIL_TO=
